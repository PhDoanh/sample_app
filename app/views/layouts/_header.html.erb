<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to t(".logo"), root_path, id: "logo" %>
    <nav>
      <div class="navbar-header">
        <button id="hamburger" type="button" class="navbar-toggle collapsed">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
      </div>
      <ul id="navbar-menu" class="nav navbar-nav navbar-right collapse navbar-collapse">
        <li><%= link_to t(".home"), root_path %></li>
        <li><%= link_to t(".help"), help_path %></li>
        <% if logged_in? %>
          <li class="dropdown">
            <a href="#" id="account" class="dropdown-toggle">
              <%= current_user.name %> <b class="caret"></b>
            </a>
            <ul id="account-menu" class="dropdown-menu">
              <li><%= link_to t(".profile"), current_user %></li>
              <li><%= link_to t(".settings"), "#" %></li>
              <li class="divider"></li>
              <li>
                <%= link_to t(".log_out"), logout_path,
                data: { "turbo-method": :delete } %>
              </li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to t(".log_in"), login_path %></li>
        <% end %>
        <li class="dropdown">
          <a href="#" id="language" class="dropdown-toggle">
            <%= I18n.locale.upcase %> <b class="caret"></b>
          </a>
          <ul id="language-menu" class="dropdown-menu">
            <% Settings.available_locales.each do |locale| %>
              <li><%= link_to locale.upcase, url_for(locale: locale) %></li>
            <% end %>
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>
