<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: Settings.user.gravatar.small_size), micropost.user %>
  <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
  <span class="content">
    <%= micropost.content %>
    <%= image_tag micropost.image.variant(resize_to_limit: Settings.micropost.image.resize_to_limit) if micropost.image.attached? %>
  </span>
  <span class="timestamp">
    <%= t(".timestamp", time: time_ago_in_words(micropost.created_at)) %>
    <% if current_user?(micropost.user) %>
      | <%= link_to t(".delete"), micropost, data: { "turbo-method": :delete, turbo_confirm: t(".confirm_delete") } %>
    <% end %>
  </span>
</li>
