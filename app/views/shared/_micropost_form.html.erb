<%= form_with(model: @micropost) do |f| %>
  <%= render "shared/error_messages", object: f.object %>

  <div class="field">
    <%= f.text_area :content, placeholder: t(".placeholder") %>
  </div>

  <span class="image">
    <%= f.file_field :image, accept: Settings.micropost.image.content_type.join(",") %>
  </span>

  <%= f.submit t(".submit"), class: "btn btn-primary" %>
<% end %>
