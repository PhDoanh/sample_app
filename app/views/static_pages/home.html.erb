<% provide(:title, t(".title")) %>

<% if logged_in? %>
  <div class="row">
    <aside class="col-md-4">
      <section class="user_info">
        <%= render "shared/user_info" %>
      </section>
      <section class="micropost_form">
        <%= render "shared/micropost_form" %>
      </section>
    </aside>
    <div class="col-md-8">
      <h3><%= t(".micropost_feed") %></h3>
      <%= render "shared/feed" %>
    </div>
  </div>
<% else %>
  <div class="center hero">
    <h1><%= t(".welcome") %></h1>
    <h2>
      <%= t(".description") %>

      <a href="<%= Settings.url.guides %>"><%= t(".tutorial_link") %></a> <%= t(".sample_app") %>
    </h2>
    <%= link_to t(".signup"), signup_path, class: "btn btn-lg btn-primary" %>
  </div>
<% end %>

<%= link_to image_tag(Settings.path.rails_logo, alt: "Rails logo", width: 200), Settings.url.rubyonrails %>
