<% provide :title, @user.name %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
    </section>
    <section class="stats">
      <%= render "shared/stats" %>
      <% if @users.any? %>
        <div class="user_avatars">
          <% @users.each do |user| %>
            <%= link_to gravatar_for(user, size: Settings.user.gravatar.tiny_size), user %>
          <% end %>
        </div>
      <% end %>
    </section>
    <section class="follow_form">
      <%= render "follow_form" %>
    </section>
  </aside>
  <% if @user.microposts.any? %>
    <div class="col-md-8">
      <h3><%= t(".microposts.heading", count: @user.microposts.count) %></h3>
      <ol class="microposts">
        <%= render @microposts %>
      </ol>
      <%= render "shared/pagination" %>
    </div>
  <% end %>
</div>
